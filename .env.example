# Server Configuration
PORT=8080

# Logging: ERROR | WARN | INFO | DEBUG
LOG_LEVEL=INFO
LOG_TO_FILE=false

# Payload obfuscation key (XOR fallback for Unity client).
# This is obfuscation, NOT security - plaintext JSON is always accepted.
# The Unity client's DeriveKeyBytes uses SHA-256 of this value.
PAYLOAD_SECRET=change-me
